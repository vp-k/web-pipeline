{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "approval",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "phase": {
          "enum": [
            "design",
            "review",
            "release"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "approved_utc": {
          "type": "string",
          "format": "date-time"
        },
        "expires_utc": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "const": "APPROVED"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tree_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"
        },
        "run_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "PASS"
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "description",
              "status",
              "evidence",
              "sha256"
            ]
          }
        },
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {"properties": {"phase": {"enum": ["review", "release"]}}},
          "then": {"required": ["tree_digest", "run_id", "run_digest"]}
        }
      ],
      "required": [
        "task_id",
        "revision",
        "fingerprint",
        "phase",
        "role",
        "identity",
        "approved_utc",
        "expires_utc",
        "outcome",
        "scope",
        "conditions"
      ]
    },
    "signature": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "payload",
    "signature"
  ]
}
