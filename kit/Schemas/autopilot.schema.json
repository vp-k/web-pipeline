{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "queue_id", "plan", "started_utc", "steps", "lease", "items", "events"],
  "dependentRequired": {
    "budget_version": ["active_seconds", "renewals"],
    "active_seconds": ["budget_version"], "renewals": ["budget_version"]
  },
  "allOf": [{
    "if": {"required": ["budget_version"]},
    "then": {"properties": {"lease": {"anyOf": [{"type": "null"}, {"required": ["started_utc"]}]}}}
  }],
  "properties": {
    "budget_version": {"const": 1},
    "active_seconds": {"type": "number", "minimum": 0},
    "renewals": {"type": "array", "items": {"type": "object"}},
    "schema_version": {"const": "1.0"},
    "queue_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "plan": {"type": "object"},
    "started_utc": {"type": "string", "format": "date-time"},
    "steps": {"type": "integer", "minimum": 0},
    "lease": {"anyOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false,
      "required": ["token", "worker", "task_id", "action", "agent", "identity"],
      "properties": {
        "started_utc": {"type": "string", "format": "date-time"},
        "token": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "worker": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 2},
        "action": {"enum": ["PLAN", "IMPLEMENT", "REPAIR", "REVIEW", "Baseline", "Fast", "Full", "READY", "IN_PROGRESS", "VERIFYING", "DONE", "Task", "Phase"]},
        "agent": {"type": "boolean"},
        "identity": {"type": "object"}
      }
    }]},
    "items": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "revision", "cursor", "waiting", "advisory"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
        "revision": {"type": "integer", "minimum": 1},
        "cursor": {"enum": ["IMPLEMENT", "REPAIR", "FAST", "FULL"]},
        "waiting": {"type": ["string", "null"]},
        "advisory": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    }},
    "events": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["sequence", "at", "kind", "task_id"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "at": {"type": "string", "format": "date-time"},
        "kind": {"enum": ["START", "SELECT", "EXECUTED", "WAIT", "WAITING", "DECISION", "RECOVER", "RETRY", "RECONCILE", "RENEW", "LEASE_END"]},
        "task_id": {"type": ["string", "null"]}
      }
    }}
  }
}
