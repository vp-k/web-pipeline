{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planning analysis and clarification evidence",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "revision", "analysis", "questions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
    "revision": {"type": "integer", "minimum": 1},
    "analysis": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["area", "finding", "sources"],
        "properties": {
          "area": {"enum": ["goal_scope", "user_flow", "exceptions", "data_integrations", "constraints", "acceptance"]},
          "finding": {"type": "string"},
          "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "question", "impact", "resolution"],
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "question": {"$ref": "#/$defs/text"},
          "impact": {"$ref": "#/$defs/text"},
          "resolution": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object", "additionalProperties": false,
                "required": ["answer", "source", "acceptance_ids"],
                "properties": {
                  "answer": {"$ref": "#/$defs/text"},
                  "source": {"$ref": "#/$defs/source"},
                  "acceptance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reference", "excerpt"],
      "properties": {
        "kind": {"enum": ["document", "user_message"]},
        "reference": {"$ref": "#/$defs/text"},
        "excerpt": {"$ref": "#/$defs/text"}
      }
    }
  }
}
