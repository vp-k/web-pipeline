{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trust",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "human"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "public_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "roles",
          "public_key"
        ]
      }
    }
  },
  "required": [
    "identities"
  ]
}
