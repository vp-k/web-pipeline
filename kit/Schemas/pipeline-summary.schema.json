{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pipeline-summary",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "policy_snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"
    },
    "profile": {
      "enum": [
        "Policy",
        "Baseline",
        "Fast",
        "Full",
        "Release",
        "Task",
        "Phase"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "BLOCKED",
        "NOT_APPLICABLE",
        "INCONCLUSIVE"
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "tree_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "commit",
        "tree_digest",
        "dirty"
      ]
    },
    "started_utc": {
      "type": "string",
      "format": "date-time"
    },
    "completed_utc": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED",
              "NOT_APPLICABLE",
              "INCONCLUSIVE"
            ]
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "log": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "blocker_kind": {"enum": ["budget", "external"]}
        },
        "required": [
          "id",
          "status",
          "exit_code",
          "duration_ms",
          "log",
          "reason"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "size",
          "sha256"
        ]
      }
    },
    "failure_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "policy_snapshot",
    "schema_version",
    "run_id",
    "task_id",
    "profile",
    "status",
    "fingerprint",
    "snapshot",
    "started_utc",
    "completed_utc",
    "checks",
    "artifacts",
    "failure_fingerprint"
  ]
}
