{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["objective", "tasks"],
  "properties": {
    "objective": {"type": "string", "minLength": 1},
    "completion_gate": {"enum": ["queue", "merge"], "default": "queue"},
    "implementation_groups": {"type": "array", "minItems": 1, "maxItems": 50, "items": {
      "type": "object", "additionalProperties": false, "required": ["phase", "order"],
      "properties": {
        "phase": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
        "order": {"type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"}}
      }
    }},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 1000},
    "elapsed_minutes": {"type": "number", "exclusiveMinimum": 0, "maximum": 1440},
    "tasks": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false, "required": ["task_id", "depends_on"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }}
  }
}
